# Copy this file to .env.local and fill it in. Never commit .env.local.

# Supabase dashboard, Project Settings, API. Both values are safe to ship to the browser.
# The publishable key is called the "anon" key on older projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where this web app lives, with no slash at the end. Join links are built from it.
NEXT_PUBLIC_SITE_URL=

# Where people write to Floor itself. Shown on the account page and the legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# The phone app's store pages. Leave empty until the app is in the stores.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# ---------------------------------------------------------------------------------------------
# Server only. These never reach a browser or a phone. On Vercel they go in the project's
# Environment Variables. docs/SETUP.md says where each one comes from.
# ---------------------------------------------------------------------------------------------

# Supabase dashboard, Project Settings, API Keys: the secret key. It passes every access rule.
SUPABASE_SECRET_KEY=

# A long random word of your own. Vercel sends it when its timer sweeps the job queue.
CRON_SECRET=

# The video host for lessons: a Bunny Stream library.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_STREAM_TOKEN_KEY=
# A long random word of your own. The webhook address you give Bunny ends with it.
BUNNY_STREAM_WEBHOOK_KEY=

# Optional. Only needed if "Enhanced Security for Push Notifications" is switched on for the
# Expo project: an access token from the Expo account (docs/SETUP.md, step 7).
EXPO_ACCESS_TOKEN=

# Card payments. A long random secret of your own, 32 characters or more: mentors' processor
# keys are encrypted with it. docs/SETUP.md, step 8, has a command that makes one. Keep a copy
# somewhere safe. If it is lost or changed, every mentor has to connect their processor again.
PAYMENT_KEYS_SECRET=
# Only while trying payments out before launch: set to true to accept test keys. A space
# connected with a test key gives VIP away, so leave this empty in real use.
PAYMENTS_ALLOW_TEST_KEYS=

# Telegram teasers. The token of Floor's own bot, from @BotFather in Telegram (docs/SETUP.md,
# step 10). Whoever holds it can post as the bot, so it only ever goes here and in Vercel.
TELEGRAM_BOT_TOKEN=

# Live video. Floor's own LiveKit server (docs/SETUP.md, step 11): its address, and the key and
# secret written in its settings. LiveKit Cloud works too, with the same three settings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
