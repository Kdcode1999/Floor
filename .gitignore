# Each app has its own .gitignore. These are the repo-wide safety nets.
node_modules/
.env
.env.*
!.env.example
.DS_Store

# The key that lets a server send Android alerts for the app. It is uploaded to Expo and
# never belongs in the repo. (google-services.json is a different file and is safe to commit.)
*-firebase-adminsdk-*.json
*service-account*.json

# walk-throughs: pictures and python leftovers
checks/out/
__pycache__/
