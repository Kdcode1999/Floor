# Copy this file to .env and fill it in. Never commit .env.

# Supabase dashboard, Project Settings, API. Both values are safe to ship inside the app.
# The publishable key is called the "anon" key on older projects.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the web app lives, with no slash at the end. Join links are built from it.
EXPO_PUBLIC_SITE_URL=

# Where people write to Floor itself. Shown when a space is suspended and on the account
# screens. Leave empty and the app leaves the address out.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Alerts for the iPhone web app: the PUBLIC half of Floor's web push key pair (docs/SETUP.md,
# step 12). The private half goes only to Vercel.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
